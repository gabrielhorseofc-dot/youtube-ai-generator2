# Server-side variables. Never prefix credentials with NEXT_PUBLIC_.
# Create .env.local at the project root for development; it is ignored by Git.
# Existing shell/Vercel variables take precedence over .env.local, then .env.
# Paste your own full connection string from Neon. No default URL is provided.
# Keep Neon's SSL/TLS parameters. Use pooling for the app on Vercel;
# a direct connection is recommended for schema-management commands.
DATABASE_URL=

# Generate with: openssl rand -base64 48
# Use a unique production secret, at least 32 characters, persistent across deploys.
AUTH_SECRET=

# Google Auth Platform > Clients > Web application
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Canonical public origin, e.g. https://your-domain.com (no trailing path).
# Register https://your-domain.com/api/auth/callback/google with Google.
AUTH_URL=http://localhost:3000

# Only enable behind a trusted hosting platform/reverse proxy.
AUTH_TRUST_HOST=true

# Complete these before opening the site to the public.
SITE_OPERATOR_NAME=
SITE_CONTACT_EMAIL=
